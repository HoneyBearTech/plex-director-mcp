{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.HoneyBearTech/plex-director-mcp",
  "title": "Plex Director",
  "description": "Ask about and manage your own Plex, Radarr, Sonarr, Prowlarr and download clients.",
  "repository": {
    "url": "https://github.com/HoneyBearTech/plex-director-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/HoneyBearTech/plex-director-mcp#readme",
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/honeybeartech/plex-director-mcp:1.3.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-v",
          "value": "plex-director-data:/app/data",
          "isRequired": true,
          "description": "Keeps settings, job history and the login secret between runs. Share this volume with any other Plex Director container."
        }
      ],
      "environmentVariables": [
        {
          "name": "PLEX_URL",
          "description": "Plex server URL, e.g. http://192.168.1.10:32400",
          "isRequired": false
        },
        {
          "name": "PLEX_TOKEN",
          "description": "Plex token",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "RADARR_URL",
          "description": "Radarr URL",
          "isRequired": false
        },
        {
          "name": "RADARR_API_KEY",
          "description": "Radarr API key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "SONARR_URL",
          "description": "Sonarr URL",
          "isRequired": false
        },
        {
          "name": "SONARR_API_KEY",
          "description": "Sonarr API key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PROWLARR_URL",
          "description": "Prowlarr URL",
          "isRequired": false
        },
        {
          "name": "PROWLARR_API_KEY",
          "description": "Prowlarr API key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "SABNZBD_URL",
          "description": "SABnzbd URL",
          "isRequired": false
        },
        {
          "name": "SABNZBD_API_KEY",
          "description": "SABnzbd API key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "QBITTORRENT_URL",
          "description": "qBittorrent Web UI URL",
          "isRequired": false
        },
        {
          "name": "QBITTORRENT_USER",
          "description": "qBittorrent username",
          "isRequired": false
        },
        {
          "name": "QBITTORRENT_PASS",
          "description": "qBittorrent password",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "TAUTULLI_URL",
          "description": "Tautulli URL",
          "isRequired": false
        },
        {
          "name": "TAUTULLI_API_KEY",
          "description": "Tautulli API key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "TMDB_API_KEY",
          "description": "TMDb API Read Access Token, for filmographies and the movie-choice grid",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "WEB_PASSWORD",
          "description": "Password for the web dashboard the same container serves on port 3000 (strongly recommended)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "SETTINGS_ENCRYPTION_KEY",
          "description": "Encrypts the saved service credentials: 32 random bytes, base64 (openssl rand -base64 32). Every container sharing the data volume needs the same key (recommended)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
