# Plex Director configuration example.
#
# Copy this file to .env (for `npm start`) or to plex-director.env (for Docker's
# --env-file or env_file), then fill in only what you use. Nothing is required:
# every service can also be entered on the dashboard's Settings page.
#
# Rules that matter, because Docker reads env files literally:
# - Put each comment on its own line, never after a value.
# - Don't put quotes around values when the file is used with Docker.
# - Never commit your filled-in copy. .env is in .gitignore.
#
# The full reference is in README.md, under "Environment variable reference".

# ---------------------------------------------------------------------------
# Service connections
#
# On first start these are copied into the database in /app/data. From then
# on the value saved in the database wins, so changing one here later does
# nothing: change it on the Settings page instead.
# ---------------------------------------------------------------------------

# Radarr URL, e.g. http://192.168.1.10:7878 (inside Docker, localhost is the container itself)
RADARR_URL=
# Radarr API key, from Radarr's Settings > General
RADARR_API_KEY=
# Optional: name of the quality profile new movies get; blank uses Radarr's first profile
RADARR_DEFAULT_QUALITY_PROFILE=

# Sonarr URL, e.g. http://192.168.1.10:8989
SONARR_URL=
# Sonarr API key, from Sonarr's Settings > General
SONARR_API_KEY=

# Prowlarr URL, e.g. http://192.168.1.10:9696
PROWLARR_URL=
# Prowlarr API key, from Prowlarr's Settings > General
PROWLARR_API_KEY=

# SABnzbd URL, e.g. http://192.168.1.10:8080
SABNZBD_URL=
# SABnzbd API key, from SABnzbd's Config > General
SABNZBD_API_KEY=

# qBittorrent Web UI URL, e.g. http://192.168.1.10:8080
QBITTORRENT_URL=
# qBittorrent Web UI username
QBITTORRENT_USER=
# qBittorrent Web UI password
QBITTORRENT_PASS=

# Tautulli URL, without /api/v2, e.g. http://192.168.1.10:8181
TAUTULLI_URL=
# Tautulli API key, from Tautulli's Settings > Web Interface
TAUTULLI_API_KEY=

# Plex server URL, e.g. http://192.168.1.10:32400
PLEX_URL=
# Plex X-Plex-Token (see the README for where to find it); treat it like a password
PLEX_TOKEN=
# Optional: comma-separated Plex library names to leave out of searches, e.g. Sports
PLEX_SKIP_LIBRARIES=

# TMDb API Read Access Token (the long one), not the short v3 API key
TMDB_API_KEY=

# Optional: comma-separated hosts to monitor over SSH, e.g. 192.168.1.10,192.168.1.11:2222
UBUNTU_HOSTS=
# The SSH user for those hosts (a dedicated, unprivileged user is best)
SSH_USER=

# ---------------------------------------------------------------------------
# Container settings
#
# Read from the environment every time; never stored in the database or shown
# on the Settings page.
# ---------------------------------------------------------------------------

# Password for the web dashboard. Strongly recommended: without it, anyone who can reach the port can change settings
WEB_PASSWORD=
# Only used without WEB_PASSWORD: extra host names the dashboard answers to, comma-separated (for example the name a
# reverse proxy serves it on). IPs, localhost, single-word names and .local/.lan/.home.arpa/.internal names always work.
WEB_ALLOWED_HOSTS=
# The reverse proxy in front of the dashboard, if any: its address or subnet, comma-separated (e.g. 192.168.40.10 or
# 192.168.40.0/24), or loopback. Only it may set X-Forwarded-For/-Proto; unset, those headers are ignored.
WEB_TRUST_PROXY=
# Port the dashboard listens on inside the container (default 3000)
WEB_PORT=3000
# Anthropic API key for the Query chat (pay-per-use, separate from a Claude subscription)
ANTHROPIC_API_KEY=
# Path, inside the container, to the private key for SSH host monitoring, e.g. /ssh/id_ed25519
SSH_KEY_PATH=
# Passphrase for that private key, only if it has one
SSH_KEY_PASSPHRASE=
# Optional: Discord webhook URL for job-completed and job-paused notifications
DISCORD_WEBHOOK_URL=
# Seconds between job-runner steps (default 60, minimum 10, 0 turns the runner off)
JOB_RUNNER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Used by the test suite only. Leave these unset.
#
# PLEX_DIRECTOR_DB_PATH points the app at a different SQLite file, and
# PLEX_DIRECTOR_SKIP_DOTENV=1 stops it reading .env. test/setup.ts sets both.
# ---------------------------------------------------------------------------
