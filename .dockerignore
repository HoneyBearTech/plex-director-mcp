# Patterns here match from the root of the build context only, so each one
# that can also turn up in a subfolder (web/node_modules, web/dist, a stray
# .env or key anywhere) starts with **/. Without it a local build copied the
# host's web/node_modules over the one installed in the image.
**/node_modules
data
**/dist

# Environment files and secrets
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Local databases and runtime state
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal
**/*.log
**/*.log.*

# VCS, editor, and CI metadata
.git
.github
.vscode
**/.DS_Store
