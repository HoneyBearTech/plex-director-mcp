{
  "name": "plex-director-mcp",
  "version": "1.2.0",
  "description": "A Plex Director MCP that will manage my Servarr Stack",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=80 \"test/**/*.test.ts\"",
    "start": "tsx src/index.ts",
    "build:skill": "tsx scripts/build-skill.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . --error-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBearTech/plex-director-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HoneyBearTech/plex-director-mcp/issues"
  },
  "homepage": "https://github.com/HoneyBearTech/plex-director-mcp#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
